{
  "name": "foodstack-sales",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:public-exposure": "node scripts/audit-public-exposure.mjs",
    "audit:legal-data": "node scripts/audit-legal-data.mjs",
    "audit:media": "node scripts/audit-media.mjs",
    "audit:security-config": "node scripts/audit-security-config.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run audit:public-exposure && npm run audit:legal-data && npm run audit:media && npm run audit:security-config"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.553.0",
    "next": "^16.3.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.7.0",
    "three": "^0.185.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "9.39.1",
    "eslint-config-next": "^15.5.18",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  }
